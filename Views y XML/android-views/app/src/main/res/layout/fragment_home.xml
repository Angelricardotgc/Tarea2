<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catálogo de componentes de UI"
            android:textColor="@color/brand_primary_variant"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Esta aplicación reúne, en seis secciones, los componentes de interfaz más comunes de Android construidos con Views y XML. Cada elemento incluye su nombre, una breve explicación y una demostración con la que puedes interactuar de verdad. Usa el menú (ícono superior izquierdo) para moverte entre secciones."
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_marginHorizontal="0dp"
            android:layout_marginTop="20dp"
            android:text="Secciones disponibles" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="6dp"
            android:text="1. Entrada de texto\n2. Botones y acciones\n3. Elementos de selección\n4. Listas y colecciones\n5. Información y retroalimentación\n6. Contenedores y estructura"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_marginHorizontal="0dp"
            android:text="Conexión entre secciones" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="En la Sección 1 puedes escribir un nombre y agregarlo a tus favoritos; ese dato aparece automáticamente al inicio de la lista vertical de la Sección 4, demostrando el intercambio de datos entre pantallas mediante un ViewModel compartido."
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
