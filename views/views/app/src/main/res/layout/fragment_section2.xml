<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Tipos básicos -->
        <com.google.android.material.card.MaterialCardView style="@style/ItemCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ItemTitle" android:text="Botón relleno, contorno y de texto" />
                <TextView style="@style/ItemDesc" android:text="Tres jerarquías visuales de un mismo tipo de acción: la más destacada (relleno), una intermedia (contorno) y la más ligera (solo texto)." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRelleno" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Relleno" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnContorno" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="Contorno" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTexto" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Texto" />
                </LinearLayout>
                <TextView android:id="@+id/tvRespuestaBasicos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:text="Toca un botón para ver la respuesta aquí." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Iconos -->
        <com.google.android.material.card.MaterialCardView style="@style/ItemCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ItemTitle" android:text="Botones con ícono" />
                <TextView style="@style/ItemDesc" android:text="Un botón puede mostrar solo un ícono (acción compacta) o un ícono acompañado de texto (acción más explícita)." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSoloIcono"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:icon="@android:drawable/ic_input_add" app:iconGravity="textStart" app:iconPadding="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIconoTexto"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Compartir"
                        app:icon="@android:drawable/ic_menu_share" />
                </LinearLayout>
                <TextView android:id="@+id/tvRespuestaIconos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FAB -->
        <com.google.android.material.card.MaterialCardView style="@style/ItemCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ItemTitle" android:text="Botón de acción flotante (FAB)" />
                <TextView style="@style/ItemDesc" android:text="Resalta la acción principal de una pantalla. Existe en versión normal (solo ícono) y extendida (ícono + texto)." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabNormal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:src="@android:drawable/ic_input_add"
                        app:fabSize="normal" />
                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fabExtendido"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Crear nuevo"
                        app:icon="@android:drawable/ic_input_add" />
                </LinearLayout>
                <TextView android:id="@+id/tvRespuestaFab" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Toggle / segmentado -->
        <com.google.android.material.card.MaterialCardView style="@style/ItemCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ItemTitle" android:text="Selector segmentado" />
                <TextView style="@style/ItemDesc" android:text="Grupo de botones de alternancia donde solo una opción puede estar activa a la vez." />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroup"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDia" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Día" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSemana" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Semana" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMes" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mes" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/tvRespuestaToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Deshabilitado / carga -->
        <com.google.android.material.card.MaterialCardView style="@style/ItemCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/ItemTitle" android:text="Botón deshabilitado y en carga" />
                <TextView style="@style/ItemDesc" android:text="Un botón deshabilitado no responde al toque. El botón de carga simula una operación en curso y se vuelve a habilitar al terminar." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deshabilitado" android:enabled="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCarga"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Guardar" />
                    <ProgressBar
                        android:id="@+id/progressCarga"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
